# CTI ground station on the Raspberry Pi: hny_server.py with the Ra-01
# receiver (../receiver/build/cti_receiver) that it starts itself.
# Portal on port 8700, reachable from the LAN.
#
# The paths assume the repository is cloned to /home/pi/cti_cubesat
# and the receiver has been built (../receiver/build.sh). Adjust User, Group
# and WorkingDirectory to your Pi, then:
#
#   sudo cp cti-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cti-server
#   journalctl -u cti-server -f            # live log
[Unit]
Description=CTI ground station (Ra-01 receiver + CTI server and portal)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=spi gpio
WorkingDirectory=/home/pi/cti_cubesat/ground_station/server
ExecStart=/usr/bin/python3 -u hny_server.py --radio --host 0.0.0.0
Restart=on-failure
RestartSec=5
# stops the receiver child too, so SPI and the GPIO lines are released
KillMode=control-group

[Install]
WantedBy=multi-user.target
